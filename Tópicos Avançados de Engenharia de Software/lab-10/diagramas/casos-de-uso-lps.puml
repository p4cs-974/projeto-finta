@startuml
left to right direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F7FAFC
  BorderColor #2D3748
  ArrowColor #4A5568
}

actor "Usuário" as Usuario
actor "Usuário autenticado" as Autenticado
actor "Usuário Web" as UsuarioWeb
actor "Usuário CLI" as UsuarioCli
actor "Provedor de mercado" as Provedor

rectangle "Finta - Linha de Produto de Software" {
  usecase "Consultar cotação" as UC1 <<comum>>
  usecase "Informar ticker" as UC2 <<comum>>
  usecase "Visualizar preço,\nvariação e moeda" as UC3 <<comum>>
  usecase "Consultar ação" as UC4 <<alternativo>>
  usecase "Consultar criptomoeda" as UC5 <<alternativo>>
  usecase "Usar cotação em cache" as UC6 <<opcional>>
  usecase "Atualizar cotação\nem segundo plano" as UC7 <<opcional>>
  usecase "Cadastrar usuário" as UC8 <<opcional>>
  usecase "Realizar login" as UC9 <<opcional>>
  usecase "Adicionar ativo favorito" as UC10 <<opcional>>
  usecase "Listar favoritos" as UC11 <<opcional>>
  usecase "Remover favorito" as UC12 <<opcional>>
  usecase "Integrar com Brapi/B3" as UC13 <<alternativo>>
  usecase "Integrar com CoinCap" as UC14 <<alternativo>>
  usecase "Usar Web App" as UC15 <<alternativo>>
  usecase "Usar CLI" as UC16 <<alternativo>>
  usecase "Visualizar dashboard" as UC17 <<opcional>>
  usecase "Executar comando headless" as UC18 <<opcional>>
  usecase "Instalar CLI" as UC19 <<opcional>>
}

Usuario --> UC1
Usuario --> UC8
Autenticado --|> Usuario
UsuarioWeb --|> Autenticado
UsuarioCli --|> Autenticado
UsuarioWeb --> UC15
UsuarioCli --> UC16
Autenticado --> UC10
Autenticado --> UC11
Autenticado --> UC12
Provedor --> UC13
Provedor --> UC14

UC1 .> UC2 : <<include>>
UC1 .> UC3 : <<include>>
UC1 .> UC4 : <<extend>>
UC1 .> UC5 : <<extend>>
UC1 .> UC6 : <<extend>>
UC6 .> UC7 : <<extend>>
UC4 .> UC13 : <<include>>
UC5 .> UC14 : <<include>>
UC10 .> UC9 : <<include>>
UC11 .> UC9 : <<include>>
UC12 .> UC9 : <<include>>
UC15 .> UC17 : <<extend>>
UC15 .> UC19 : <<extend>>
UC16 .> UC18 : <<extend>>
@enduml
